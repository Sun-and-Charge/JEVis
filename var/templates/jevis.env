#!/bin/bash
set -a

JEVIS_HOME=/home/jevis/jevis
JEVIS_TEMPLATE=${JEVIS_HOME}/var/templates
JEVIS_LOG=${JEVIS_HOME}/var/log
JEVIS_BIN=${JEVIS_HOME}/bin

# Java 25 for the web service and the services (e.g. Azul Zulu 25), put first in the PATH
JAVA_HOME=/usr/lib/jvm/zulu25
[ -x "${JAVA_HOME}/bin/java" ] && PATH=${JAVA_HOME}/bin:$PATH
PATH=$PATH:$JEVIS_BIN
TZ=UTC

set +a
