<?xml version="1.0" encoding="UTF-8"?>
<!-- const.xml -->
<config>
    <datasource>
        <url>127.0.0.1</url>
        <port>3306</port>
        <login>jevis</login>
        <password>dbpassword</password>
        <schema>jevis</schema>
        <options>useSSL=false</options>
    </datasource>
    <webservice>
        <uri>http://hostname:8000/</uri>
        <i18ndir>/home/jevis/jevis/var/i18n</i18ndir>
        <filedir>/home/jevis/jevis/var/files/</filedir>
        <classdir>/home/jevis/jevis/var/classes/</classdir>
        <!-- optional: start page (sunandcharge-app-web) served at / and /web/, and the built web app at /app/ -->
        <!-- <webpage>/home/jevis/sunandcharge-app-web</webpage> -->
        <!-- <webapp>/home/jevis/jevis/JEWebApp/dist</webapp> -->
        <jeccversion>3.9.12</jeccversion>
        <auth>
            <!-- legacy HTTP Basic auth for old clients, switch off once all JECC/launcher/services are updated -->
            <basic>true</basic>
            <!-- access token idle timeout in minutes, "remember me" duration in days -->
            <accesstimeout>480</accesstimeout>
            <refreshtimeout>30</refreshtimeout>
            <lockout>
                <threshold>5</threshold>
                <minutes>15</minutes>
            </lockout>
            <mfa>
                <!-- who must use two-factor authentication: none | sysadmin | all -->
                <required>none</required>
                <!-- key to encrypt the 2FA secrets, created on first use; back it up together with the database -->
                <keyfile>/home/jevis/jevis/etc/mfa.key</keyfile>
            </mfa>
        </auth>
        <registration>
            <root>1</root>
            <demogroup>1</demogroup>
            <apikey>UIGDUSG023Bxdh283frehbo90</apikey>
        </registration>
        <!-- old data archive (OpenJEVis #1440): complete years older than <olderthanyears> are written per data row
             and year as gzip CSV into <dir>, verified and then deleted from the database. Manual runs and restore:
             java -cp JEWebService-<version>-jar-with-dependencies.jar org.jevis.rest.archive.ArchiveTool -c <this file> dry-run|archive|verify|restore
        <archive>
            <enabled>false</enabled>
            <dir>/home/jevis/jevis/var/archive/</dir>
            <olderthanyears>5</olderthanyears>
            <classes>Data</classes>
            <attributes>Value</attributes>
            <time>03:00</time>
            <maxrows>2000000</maxrows>
            <maxminutes>60</maxminutes>
            <batchsize>5000</batchsize>
            <pausems>100</pausems>
        </archive>
        -->
    </webservice>


</config>
