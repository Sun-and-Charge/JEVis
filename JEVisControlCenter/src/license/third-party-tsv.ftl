<#-- Template for the license-maven-plugin (add-third-party).
     One tab separated line per dependency: group, artifact, version, name, url, licenses ('|' separated).
     The file is read by org.jevis.jeconfig.dialog.LicenseDialog. -->
<#function clean value="">
    <#return (value!"")?replace("\t", " ")?replace("\r", " ")?replace("\n", " ")?trim>
</#function>
# Generated by the license-maven-plugin during the build. Do not edit.
<#list dependencyMap as e>
<#assign project = e.getKey()/>
<#assign licenses = e.getValue()/>
${clean(project.groupId!"")}	${clean(project.artifactId!"")}	${clean(project.version!"")}	${clean(project.name!"")}	${clean(project.url!"")}	<#list licenses as license>${clean(license)}<#if license_has_next>|</#if></#list>
</#list>
