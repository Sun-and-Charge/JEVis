    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Project license and notice, shown in Help > Licenses -->
            <resource>
                <directory>${project.basedir}/..</directory>
                <targetPath>jevis-licenses</targetPath>
                <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                </includes>
            </resource>
            <!-- Third-party license list generated by the license-maven-plugin -->
            <resource>
                <directory>${project.build.directory}/generated-resources/jevis-licenses</directory>
                <targetPath>jevis-licenses</targetPath>
            </resource>
        </resources>
        <plugins>

            <!-- Collects the licenses of all dependencies for the license dialog (Help > Licenses).
                 New dependencies are picked up automatically on every build. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>2.4.0</version>
                <executions>
                    <execution>
                        <id>third-party-licenses</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>add-third-party</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <outputDirectory>${project.build.directory}/generated-resources/jevis-licenses</outputDirectory>
                    <thirdPartyFilename>THIRD-PARTY.txt</thirdPartyFilename>
                    <fileTemplate>${project.basedir}/src/license/third-party-tsv.ftl</fileTemplate>
                    <useMissingFile>true</useMissingFile>
                    <missingFile>${project.basedir}/src/license/THIRD-PARTY.properties</missingFile>
                    <excludedScopes>test,provided,system</excludedScopes>
                    <excludedGroups>^org\.jevis</excludedGroups>
                    <failOnMissing>false</failOnMissing>
                    <licenseMerges>
                        <licenseMerge>Apache License 2.0|The Apache Software License, Version 2.0|Apache License, Version 2.0|Apache 2.0|Apache 2|Apache-2.0|Apache License Version 2.0|The Apache License, Version 2.0|ASF 2.0|Apache Software License - Version 2.0|Apache License v2.0|AL 2.0|Apache 2.0 License|Apache License, 2.0|Apache Version 2.0|Apache License, version 2.0</licenseMerge>
                        <licenseMerge>MIT License|MIT|The MIT License|The MIT License (MIT)|MIT license</licenseMerge>
                        <licenseMerge>BSD 3-Clause License|BSD-3-Clause|New BSD License|The BSD 3-Clause License|BSD 3-clause|Revised BSD|3-Clause BSD License|BSD License 3|BSD 3-Clause|The 3-Clause BSD License|Modified BSD</licenseMerge>
                        <licenseMerge>BSD 2-Clause License|BSD 2-Clause|BSD-2-Clause|The BSD 2-Clause License|Simplified BSD License</licenseMerge>
                        <licenseMerge>Eclipse Public License 1.0|Eclipse Public License - v 1.0|EPL 1.0</licenseMerge>
                        <licenseMerge>Eclipse Public License 2.0|Eclipse Public License - v 2.0|EPL 2.0|EPL-2.0|Eclipse Public License v2.0</licenseMerge>
                        <licenseMerge>GNU Lesser General Public License 2.1|GNU Lesser General Public License|LGPL 2.1|LGPL-2.1|GNU LESSER GENERAL PUBLIC LICENSE, Version 2.1</licenseMerge>
                        <licenseMerge>GNU Lesser General Public License 3.0|LGPL 3.0|LGPLv3|LGPL-3.0|GNU Lesser General Public License v3.0</licenseMerge>
                        <licenseMerge>GPL 2.0 with Classpath Exception|GPL2 w/ CPE|GPL-2.0-with-classpath-exception|The GNU General Public License (GPL), Version 2, With Classpath Exception</licenseMerge>
                        <licenseMerge>CDDL 1.0|Common Development and Distribution License (CDDL) v1.0|COMMON DEVELOPMENT AND DISTRIBUTION LICENSE (CDDL) Version 1.0</licenseMerge>
                        <licenseMerge>Eclipse Distribution License 1.0|Eclipse Distribution License - v 1.0|EDL 1.0</licenseMerge>
                    </licenseMerges>
                </configuration>
            </plugin>


            <plugin>
                <goals></goals>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <archive>
                        <manifestEntries>
                            <Permissions>all-permissions</Permissions>
                            <JavaFX-Version>8.0</JavaFX-Version>
                            <url>${project.parent.url}</url>
                            <implementation-vendor>${project.organization.name}</implementation-vendor>
                            <implementation-title>${project.name}</implementation-title>
                            <implementation-version>${project.version}</implementation-version>
                            <Application-Name>${project.name}</Application-Name>
                        </manifestEntries>
                        <manifest>
                            <mainClass>org.jevis.jeconfig.JEConfig</mainClass>
                        </manifest>
                    </archive>

                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>

            </plugin>
            <!-- Skip animal-sniffer: JavaFX APIs are not in the standard java18 signature -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>animal-sniffer-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>


