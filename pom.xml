<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>org.jevis</groupId>
    <artifactId>JEVisCore</artifactId>
    <version>3.4</version>
    <name>JEVis Core</name>
    <packaging>pom</packaging>
    <description>JEVis - energy and operational data storage, monitoring and analysis</description>
    <url>https://github.com/Sun-and-Charge/JEVis</url>
    <inceptionYear>2009</inceptionYear>

    <organization>
        <name>Sun and Charge Germany GmbH</name>
        <url>https://github.com/Sun-and-Charge</url>
    </organization>

    <licenses>
        <license>
            <name>GNU General Public License v3.0 only</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.html</url>
            <distribution>repo</distribution>
            <comments>Based on OpenJEVis, Copyright (C) Envidatec GmbH. See NOTICE.</comments>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/Sun-and-Charge/JEVis</url>
        <connection>scm:git:https://github.com/Sun-and-Charge/JEVis.git</connection>
        <developerConnection>scm:git:https://github.com/Sun-and-Charge/JEVis.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/Sun-and-Charge/JEVis/issues</url>
    </issueManagement>

    <modules>
        <module>JEAPI</module>
        <module>JEAPI-WS</module>
        <module>JECommons</module>
        <module>JEWebService</module>
        <module>JEVisControlCenter/</module>
        <module>DataCollector</module>
        <module>JECalc</module>
        <module>JEReport</module>
        <module>Notifier</module>
        <module>JEDataProcessor</module>
        <module>JEStatus</module>
        <module>JEAlarm</module>
    </modules>

    <profiles>
        <!-- Adds the database migrations. Note: building mysqldb runs Flyway clean + migrate against
             the database configured in mysqldb/pom.xml. -->
        <profile>
            <id>jevisserver</id>
            <modules>
                <module>mysqldb</module>
            </modules>
        </profile>
    </profiles>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>

        <log4j.version>2.24.1</log4j.version>
        <jackson.version>2.15.1</jackson.version>
        <poi.version>5.3.0</poi.version>
        <bouncycastle.version>1.78.1</bouncycastle.version>
        <junixsocket.version>2.6.2</junixsocket.version>
    </properties>

    <build>
        <plugins>
            <!-- Reports dependency version conflicts, does not fail the build -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>dependency-convergence</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <dependencyConvergence/>
                            </rules>
                            <fail>false</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>3.7.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.7.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.4.1</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>animal-sniffer-maven-plugin</artifactId>
                    <version>1.24</version>
                    <configuration>
                        <signature>
                            <groupId>org.codehaus.mojo.signature</groupId>
                            <artifactId>java18</artifactId>
                            <version>1.0</version>
                        </signature>
                    </configuration>
                    <executions>
                        <execution>
                            <id>check-java8</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

